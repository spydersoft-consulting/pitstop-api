    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Auth": {
    "Authority": "https://auth.mattgerega.net",
    "Audience": "pitstop-api"
  },
  "Telemetry": {
    "ServiceName": "pitstop",
