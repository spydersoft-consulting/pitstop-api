{
  "AllowedHosts": "*",
  "Auth": {
    "Audience": "pitstop-api",
    "Authority": "https://auth.mattgerega.net"
  },
  "HealthCheck": {
    "LiveTags": [],
    "ReadyTags": [],
    "StartupTags": []
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
