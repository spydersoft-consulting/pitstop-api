    "MeterName": "pitstop",
    "Metrics": {
      "Otlp": {
        "Endpoint": "http://otel-collector:4317"
      },
      "Type": "otlp"
    },
    "ServiceName": "pitstop",
    "Trace": {
      "Otlp": {
        "Endpoint": "http://otel-collector:4317"
      },
      "Type": "otlp"
    }
  }
